{
  "name": "pricecompare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Compare one product across e-commerce sites: price difference, seller and ratings",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server/main.ts & vite",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "vite build && node tests/e2e/ui.mjs"
  },
  "dependencies": {
    "node-html-parser": "9.0.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
